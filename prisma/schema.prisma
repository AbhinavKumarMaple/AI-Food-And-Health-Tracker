// AI Food & Health Tracker — Supabase Postgres schema.
// Domain-aligned: meals embed items, symptoms embed triggers, day summaries embed
// rating samples (as JSON), matching the app's DataStore types so the server
// implementation maps 1:1. Analytics run in application code, not SQL joins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) for runtime
  directUrl = env("DIRECT_URL") // direct/session for migrations
}

enum ParseStatus {
  draft
  parsed
  confirmed
  discarded
}

enum EntrySource {
  voice
  text
  manual
}

enum InputType {
  voice
  text
  mixed
}

enum Units {
  metric
  imperial
}

enum FollowUpAggressiveness {
  low
  medium
  high
}

enum TimeConfidence {
  exact
  approx
  inferred
}

enum FollowUpTargetType {
  meal
  symptom
  mood
  hydration
  day
  general
}

enum FollowUpStatus {
  pending
  answered
  dismissed
}

enum TriggerSource {
  user
  ai
}

enum InsightType {
  food_symptom_correlation
  trend
  streak
  trigger
  general
}

enum InsightStatus {
  active
  dismissed
  confirmed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("UTC")

  dateOfBirth       DateTime?
  sex               String?
  heightCm          Float?
  weightKg          Float?
  knownAllergies    String[] @default([])
  intolerances      String[] @default([])
  chronicConditions String[] @default([])
  medications       String[] @default([])
  dietaryPattern    String?
  healthGoals       String[] @default([])

  // Region + spoken languages — given to the AI so it transcribes and corrects
  // regional Indian food names (e.g. bhakri, thecha, pithla) accurately.
  location  String?
  languages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  geminiApiKeyCiphertext String?
  geminiApiKeyIv         String?
  geminiApiKeyTag        String?

  selectedModel          String                 @default("gemini-2.5-flash-lite")
  units                  Units                  @default(metric)
  followUpAggressiveness FollowUpAggressiveness @default(medium)

  updatedAt DateTime @updatedAt
}

model LogSession {
  id     String @id @default(cuid())
  userId String

  inputType            InputType   @default(voice)
  audioDurationSeconds Float?
  transcript           String?     @db.Text
  typedTextBefore      String?     @db.Text
  typedTextAfter       String?     @db.Text
  geminiModelUsed      String?
  rawAiResponse        Json?
  parseStatus          ParseStatus @default(draft)
  entryCount           Int         @default(0)
  error                String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([userId, createdAt])
}

model Meal {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt        DateTime
  timeConfidence    TimeConfidence @default(exact)
  mealType          String         @default("other")
  title             String
  description       String?        @db.Text
  location          String?
  restaurantName    String?
  socialContext     String?
  hungerBefore      Int?
  fullnessAfter     Int?
  preparation       String?
  estimatedCalories Int?
  macros            Json?
  portionSize       String?
  completenessScore Int            @default(0)
  aiConfidence      Float?
  source            EntrySource    @default(voice)
  notes             String?        @db.Text
  items             Json           @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
}

model Symptom {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt        DateTime
  timeConfidence    TimeConfidence @default(exact)
  symptomType       String         @default("other")
  title             String
  severity          Int            @default(3)
  durationMinutes   Int?
  isOngoing         Boolean        @default(false)
  resolvedAt        DateTime?
  bodyLocation      String?
  description       String?        @db.Text
  completenessScore Int            @default(0)
  aiConfidence      Float?
  source            EntrySource    @default(voice)
  triggers          Json           @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, symptomType])
}

model Mood {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt  DateTime
  rating      Int
  label       String?
  energyLevel Int?
  stressLevel Int?
  notes       String?     @db.Text
  source      EntrySource @default(voice)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
}

model HydrationLog {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt   DateTime
  amountMl     Int
  beverageType String      @default("water")
  notes        String?
  source       EntrySource @default(voice)

  createdAt DateTime @default(now())

  @@index([userId, occurredAt])
}

model DaySummary {
  id     String @id @default(cuid())
  userId String

  date             String // YYYY-MM-DD (local calendar day)
  overallRating    Float?
  ratingLabel      String?
  ratingCapturedAt DateTime?
  ratingSamples    Json      @default("[]")
  isClosed         Boolean   @default(false)
  reflection       String?   @db.Text
  aiSummary        String?   @db.Text
  mealCount        Int       @default(0)
  symptomCount     Int       @default(0)
  moodAvg          Float?
  totalWaterMl     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model FollowUpQuestion {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  targetType   FollowUpTargetType
  targetId     String?
  questionText String             @db.Text
  fieldHint    String?
  status       FollowUpStatus     @default(pending)
  answerText   String?            @db.Text
  generatedBy  String             @default("ai")

  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([userId, status])
}

model Insight {
  id     String @id @default(cuid())
  userId String

  insightType   InsightType
  subjectKind   String?
  subjectValue  String?
  objectKind    String?
  objectValue   String?
  title         String
  description   String        @db.Text
  strength      Float?
  supportCount  Int?
  exposureCount Int?
  confidence    Float?
  avgLagMinutes Int?
  periodStart   DateTime?
  periodEnd     DateTime?
  status        InsightStatus @default(active)
  evidence      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
