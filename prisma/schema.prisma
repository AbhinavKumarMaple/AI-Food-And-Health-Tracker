// AI Food & Health Tracker — data model
// Principle: capture as much structured detail as possible so food→health
// patterns can be detected later. All user-owned rows carry userId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (app-controlled lifecycle fields). Open-ended, AI-filled categorical
// values (mealType, symptomType, foodCategory, beverageType) are stored as
// String for flexibility and normalized/validated in application code.
// ----------------------------------------------------------------------------

enum ParseStatus {
  draft
  parsed
  confirmed
  discarded
}

enum EntrySource {
  voice
  text
  manual
}

enum InputType {
  voice
  text
  mixed
}

enum Units {
  metric
  imperial
}

enum FollowUpAggressiveness {
  low
  medium
  high
}

enum TimeConfidence {
  exact
  approx
  inferred
}

enum FollowUpTargetType {
  meal
  symptom
  mood
  hydration
  day
  general
}

enum FollowUpStatus {
  pending
  answered
  dismissed
}

enum TriggerSource {
  user
  ai
}

enum InsightType {
  food_symptom_correlation
  trend
  streak
  trigger
  general
}

enum InsightStatus {
  active
  dismissed
  confirmed
}

// ----------------------------------------------------------------------------
// Identity & settings
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("UTC")

  // Health context (improves pattern accuracy)
  dateOfBirth       DateTime?
  sex               String?
  heightCm          Float?
  weightKg          Float?
  knownAllergies    String[] @default([])
  intolerances      String[] @default([])
  chronicConditions String[] @default([])
  medications       String[] @default([])
  dietaryPattern    String?
  healthGoals       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings      UserSettings?
  logSessions   LogSession[]
  meals         Meal[]
  symptoms      Symptom[]
  moods         Mood[]
  hydrationLogs HydrationLog[]
  daySummaries  DaySummary[]
  followUps     FollowUpQuestion[]
  insights      Insight[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Gemini API key encrypted at rest (AES-256-GCM)
  geminiApiKeyCiphertext String?
  geminiApiKeyIv         String?
  geminiApiKeyTag        String?

  selectedModel         String                 @default("gemini-2.0-flash")
  units                 Units                  @default(metric)
  followUpAggressiveness FollowUpAggressiveness @default(medium)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Capture session (raw input + AI output)
// ----------------------------------------------------------------------------

model LogSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inputType            InputType   @default(voice)
  audioPath            String?
  audioMime            String?
  audioDurationSeconds Float?
  transcript           String?     @db.Text
  typedTextBefore      String?     @db.Text
  typedTextAfter       String?     @db.Text
  geminiModelUsed      String?
  rawAiResponse        Json?
  parseStatus          ParseStatus @default(draft)
  entryCount           Int         @default(0)
  error                String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  meals         Meal[]
  symptoms      Symptom[]
  moods         Mood[]
  hydrationLogs HydrationLog[]
  followUps     FollowUpQuestion[]

  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// Meals & structured food items
// ----------------------------------------------------------------------------

model Meal {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logSessionId String?
  logSession   LogSession? @relation(fields: [logSessionId], references: [id], onDelete: SetNull)

  occurredAt     DateTime
  timeConfidence TimeConfidence @default(exact)
  mealType       String         @default("other") // breakfast|lunch|dinner|snack|drink|other
  title          String
  description    String?        @db.Text

  location       String?
  restaurantName String?
  socialContext  String?
  hungerBefore   Int? // 1-5
  fullnessAfter  Int? // 1-5
  preparation    String? // home_cooked|restaurant|packaged|takeout|other

  estimatedCalories Int?
  macros            Json? // { protein_g, carbs_g, fat_g, fiber_g, sugar_g, sodium_mg }
  portionSize       String?

  completenessScore Int         @default(0) // 0-100
  aiConfidence      Float? // 0-1
  source            EntrySource @default(voice)
  notes             String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    MealItem[]
  triggers SymptomTrigger[]

  @@index([userId, occurredAt])
}

model MealItem {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name          String
  canonicalName String // normalized for correlation (lowercased/singular)
  quantity      Float?
  unit          String?
  foodCategory  String? // grain|dairy|fruit|vegetable|protein|fat|beverage|caffeine|alcohol|sweet|processed|other
  tags          String[] @default([]) // Fiber|Protein|Caffeine|Gluten|Dairy|Spicy|Fermented|...

  isPotentialAllergen Boolean @default(false)
  allergenType        String?
  estimatedCalories   Int?

  createdAt DateTime @default(now())

  triggers SymptomTrigger[]

  @@index([mealId])
  @@index([canonicalName])
}

// ----------------------------------------------------------------------------
// Symptoms & suspected triggers
// ----------------------------------------------------------------------------

model Symptom {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logSessionId String?
  logSession   LogSession? @relation(fields: [logSessionId], references: [id], onDelete: SetNull)

  occurredAt     DateTime // onset
  timeConfidence TimeConfidence @default(exact)
  symptomType    String         @default("other") // bloating|headache|nausea|fatigue|cramps|heartburn|skin|mood|other
  title          String
  severity       Int            @default(3) // 1-5
  durationMinutes Int?
  isOngoing      Boolean        @default(false)
  resolvedAt     DateTime?
  bodyLocation   String?
  description    String?        @db.Text

  completenessScore Int         @default(0)
  aiConfidence      Float?
  source            EntrySource @default(voice)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers SymptomTrigger[]

  @@index([userId, occurredAt])
  @@index([userId, symptomType])
}

model SymptomTrigger {
  id        String  @id @default(cuid())
  symptomId String
  symptom   Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  suspectedMealId     String?
  suspectedMeal       Meal?     @relation(fields: [suspectedMealId], references: [id], onDelete: SetNull)
  suspectedMealItemId String?
  suspectedMealItem   MealItem? @relation(fields: [suspectedMealItemId], references: [id], onDelete: SetNull)
  suspectedFoodText   String?

  relationNote   String?       @db.Text
  source         TriggerSource @default(user)
  userConfidence Int? // 1-5

  createdAt DateTime @default(now())

  @@index([symptomId])
}

// ----------------------------------------------------------------------------
// Mood & hydration
// ----------------------------------------------------------------------------

model Mood {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logSessionId String?
  logSession   LogSession? @relation(fields: [logSessionId], references: [id], onDelete: SetNull)

  occurredAt  DateTime
  rating      Int // 1-5
  label       String?
  energyLevel Int? // 1-5
  stressLevel Int? // 1-5
  notes       String?     @db.Text
  source      EntrySource @default(voice)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
}

model HydrationLog {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logSessionId String?
  logSession   LogSession? @relation(fields: [logSessionId], references: [id], onDelete: SetNull)

  occurredAt   DateTime
  amountMl     Int
  beverageType String      @default("water") // water|coffee|tea|juice|soda|alcohol|other
  notes        String?
  source       EntrySource @default(voice)

  createdAt DateTime @default(now())

  @@index([userId, occurredAt])
}

// ----------------------------------------------------------------------------
// Day rollups
// ----------------------------------------------------------------------------

model DaySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime  @db.Date
  overallRating   Int? // 1-5
  ratingLabel     String?
  ratingCapturedAt DateTime?
  isClosed        Boolean   @default(false)
  reflection      String?   @db.Text
  aiSummary       String?   @db.Text

  // denormalized rollups (recomputed on save)
  mealCount     Int @default(0)
  symptomCount  Int @default(0)
  moodAvg       Float?
  totalWaterMl  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ----------------------------------------------------------------------------
// Ask-more follow-ups
// ----------------------------------------------------------------------------

model FollowUpQuestion {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logSessionId String?
  logSession   LogSession? @relation(fields: [logSessionId], references: [id], onDelete: SetNull)

  targetType   FollowUpTargetType
  targetId     String?
  questionText String             @db.Text
  fieldHint    String?
  status       FollowUpStatus     @default(pending)
  answerText   String?            @db.Text
  generatedBy  String             @default("ai")

  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([userId, status])
}

// ----------------------------------------------------------------------------
// Pattern engine output
// ----------------------------------------------------------------------------

model Insight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  insightType  InsightType
  subjectKind  String? // food|ingredient|tag|meal_type|beverage
  subjectValue String?
  objectKind   String? // symptom_type|mood
  objectValue  String?

  title       String
  description String  @db.Text

  strength      Float? // 0-1
  supportCount  Int?
  exposureCount Int?
  confidence    Float? // 0-1
  avgLagMinutes Int?

  periodStart DateTime?
  periodEnd   DateTime?
  status      InsightStatus @default(active)
  evidence    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
