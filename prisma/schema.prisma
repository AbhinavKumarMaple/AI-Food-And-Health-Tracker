// AI Food & Health Tracker — Supabase Postgres schema.
// Domain-aligned: meals embed items, symptoms embed triggers, day summaries embed
// rating samples (as JSON), matching the app's DataStore types so the server
// implementation maps 1:1. Analytics run in application code, not SQL joins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) for runtime
  directUrl = env("DIRECT_URL") // direct/session for migrations
}

enum ParseStatus {
  draft
  processing
  parsed
  confirmed
  discarded
  failed
}

enum EntrySource {
  voice
  text
  manual
}

enum InputType {
  voice
  text
  mixed
}

enum Units {
  metric
  imperial
}

enum FollowUpAggressiveness {
  low
  medium
  high
}

enum TimeConfidence {
  exact
  approx
  inferred
}

enum FollowUpTargetType {
  meal
  symptom
  mood
  hydration
  day
  general
}

enum FollowUpStatus {
  pending
  answered
  dismissed
}

enum TriggerSource {
  user
  ai
}

enum InsightType {
  food_symptom_correlation
  trend
  streak
  trigger
  general
}

enum InsightStatus {
  active
  dismissed
  confirmed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("UTC")

  dateOfBirth       DateTime?
  sex               String?
  heightCm          Float?
  weightKg          Float?
  knownAllergies    String[] @default([])
  intolerances      String[] @default([])
  chronicConditions String[] @default([])
  medications       String[] @default([])
  dietaryPattern    String?
  healthGoals       String[] @default([])

  // Region + spoken languages — given to the AI so it transcribes and corrects
  // regional Indian food names (e.g. bhakri, thecha, pithla) accurately.
  location  String?
  languages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  geminiApiKeyCiphertext String?
  geminiApiKeyIv         String?
  geminiApiKeyTag        String?

  selectedModel          String                 @default("gemini-2.5-flash-lite")
  units                  Units                  @default(metric)
  followUpAggressiveness FollowUpAggressiveness @default(medium)

  // Menstrual cycle tracking is fully optional and off by default. Avni is a
  // food/mood/health tracker for everyone; this only switches on the cycle
  // module for users who choose to track it. Gated on this flag, never on `sex`.
  cycleTrackingEnabled Boolean @default(false)
  // User's own expected cycle length, used as a gentle prior before enough
  // periods are logged to learn a personal one (population default ~28).
  cycleAvgLengthDays Int @default(28)

  // Auto-capture free environmental context (coarse location, weather, air
  // quality, daylight, moon/season) per day. Coarse + opt-out-able.
  envTrackingEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model LogSession {
  id     String @id @default(cuid())
  userId String

  inputType            InputType   @default(voice)
  audioDurationSeconds Float?
  transcript           String?     @db.Text
  typedTextBefore      String?     @db.Text
  typedTextAfter       String?     @db.Text
  geminiModelUsed      String?
  rawAiResponse        Json?
  parseStatus          ParseStatus @default(draft)
  entryCount           Int         @default(0)
  error                String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  confirmedAt DateTime?

  @@index([userId, createdAt])
}

model Meal {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt        DateTime
  timeConfidence    TimeConfidence @default(exact)
  mealType          String         @default("other")
  title             String
  description       String?        @db.Text
  location          String?
  restaurantName    String?
  socialContext     String?
  hungerBefore      Int?
  fullnessAfter     Int?
  preparation       String?
  estimatedCalories Int?
  macros            Json?
  portionSize       String?
  completenessScore Int            @default(0)
  aiConfidence      Float?
  source            EntrySource    @default(voice)
  notes             String?        @db.Text
  items             Json           @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
}

model Symptom {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt        DateTime
  timeConfidence    TimeConfidence @default(exact)
  symptomType       String         @default("other")
  title             String
  severity          Int            @default(3)
  durationMinutes   Int?
  isOngoing         Boolean        @default(false)
  resolvedAt        DateTime?
  bodyLocation      String?
  description       String?        @db.Text
  completenessScore Int            @default(0)
  aiConfidence      Float?
  source            EntrySource    @default(voice)
  triggers          Json           @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, symptomType])
}

model Mood {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt  DateTime
  rating      Int
  label       String?
  energyLevel Int?
  stressLevel Int?
  notes       String?     @db.Text
  source      EntrySource @default(voice)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
}

model HydrationLog {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  occurredAt   DateTime
  amountMl     Int
  beverageType String      @default("water")
  notes        String?
  source       EntrySource @default(voice)

  createdAt DateTime @default(now())

  @@index([userId, occurredAt])
}

model DaySummary {
  id     String @id @default(cuid())
  userId String

  date             String // YYYY-MM-DD (local calendar day)
  overallRating    Float?
  ratingLabel      String?
  ratingCapturedAt DateTime?
  ratingSamples    Json      @default("[]")
  isClosed         Boolean   @default(false)
  reflection       String?   @db.Text
  aiSummary        String?   @db.Text
  mealCount        Int       @default(0)
  symptomCount     Int       @default(0)
  moodAvg          Float?
  totalWaterMl     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model FollowUpQuestion {
  id           String @id @default(cuid())
  userId       String
  logSessionId String?

  targetType   FollowUpTargetType
  targetId     String?
  questionText String             @db.Text
  fieldHint    String?
  status       FollowUpStatus     @default(pending)
  answerText   String?            @db.Text
  generatedBy  String             @default("ai")

  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([userId, status])
}

// One row per calendar day the user logs menstruation-specific data. Holds only
// the fields that have no home in Meal/Symptom/Mood (flow, period start, optional
// fertility biomarkers). Cycle-linked symptoms & mood reuse the existing Symptom/
// Mood models and are tagged with a derived phase by the analytics layer — never
// duplicated here. Cycles, phases, predictions and deviations are DERIVED from
// these day rows in application code, not stored.
model CycleLog {
  id     String @id @default(cuid())
  userId String

  date String // YYYY-MM-DD (user's local calendar day)

  // Day 1 of a period — the anchor for cycle length, phase, and prediction.
  isPeriodStart Boolean @default(false)
  // none | spotting | light | medium | heavy | flooding (null = not a bleeding day)
  flow String?
  // Larger-than-a-coin clots, flooding/gushing — heavy-bleeding red-flag inputs.
  clots     Boolean @default(false)
  flooding  Boolean @default(false)

  // Optional fertility biomarkers (advanced; most users log none).
  bbtCelsius    Float?
  cervicalMucus String? // dry | sticky | creamy | watery | eggwhite
  ovulationTest String? // negative | positive

  // Optional, private. Excluded from any shared/exported view by default.
  intercourse Boolean?

  notes  String?     @db.Text
  source EntrySource @default(manual)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// One auto-captured environmental snapshot per user per local calendar day,
// shared by every meal/symptom/mood/cycle entry that day. Sourced for free:
// coarse location from request IP geo, weather + air quality from Open-Meteo
// (no API key), and moon phase + season computed locally. Used as free
// covariates alongside food and cycle phase.
model DayContext {
  id     String @id @default(cuid())
  userId String

  date String // YYYY-MM-DD (user's local calendar day)

  // coarse location
  city           String?
  region         String?
  country        String?
  latitude       Float?
  longitude      Float?
  locationSource String? // ip | profile | precise | manual

  // weather (metric)
  tempMinC         Float?
  tempMaxC         Float?
  tempMeanC        Float?
  apparentMaxC     Float?
  humidityMean     Float?
  pressureMeanHpa  Float?
  pressureRangeHpa Float? // intra-day swing — barometric instability proxy
  precipitationMm  Float?
  windMaxKph       Float?
  uvIndexMax       Float?
  weatherCode      Int?
  daylightMinutes  Int?

  // air quality
  pm25Mean Float?
  pm10Mean Float?
  aqiUsMax Int?

  // computed locally (no API)
  moonPhase        String? // new | waxing_crescent | first_quarter | ...
  moonIllumination Float? // 0..1
  season           String? // winter | spring | summer | autumn

  source    String   @default("auto") // auto | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Insight {
  id     String @id @default(cuid())
  userId String

  insightType   InsightType
  subjectKind   String?
  subjectValue  String?
  objectKind    String?
  objectValue   String?
  title         String
  description   String        @db.Text
  strength      Float?
  supportCount  Int?
  exposureCount Int?
  confidence    Float?
  avgLagMinutes Int?
  periodStart   DateTime?
  periodEnd     DateTime?
  status        InsightStatus @default(active)
  evidence      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// A user's personal note on a food in the "Can I eat it?" checker — their own
// reaction/reminder layered on top of the static FODMAP data (e.g. "cucumber →
// acidity"). One note per food per user (upserted by foodKey). `isCustom` marks a
// food that isn't in the base FODMAP list, so it shows as a personal-only entry.
model FoodNote {
  id     String @id @default(cuid())
  userId String

  foodKey       String // normalized food name (lowercased) — the upsert key
  foodName      String // display name
  note          String  @db.Text
  reaction      Boolean @default(false) // "this disagrees with me" personal flag
  reactionLabel String? // short tag for the badge, e.g. "acidity"
  isCustom      Boolean @default(false) // food not in the base FODMAP list

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, foodKey])
  @@index([userId])
}
